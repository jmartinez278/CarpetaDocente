# Copiar este archivo como .env y completar los valores. No subir .env.
# Ningún valor de este archivo es una clave real: todos van vacíos.

# Django
# Clave secreta: generar una propia, por ejemplo con
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Obligatoria con Docker Compose: no arranca sin ella. En la laptop usar True
# (runserver solo sirve CSS y JS con depuración activa). Fuera de Compose,
# si se omite, la depuración queda desactivada.
DJANGO_DEBUG=
# Lista separada por comas, por ejemplo: localhost,127.0.0.1 (obligatoria con Docker Compose)
DJANGO_ALLOWED_HOSTS=

# Base de datos (PostgreSQL local con Docker Compose / Neon en la nube)
# Formato: postgres://<usuario>:<contraseña>@localhost:<puerto>/<base>
# Con Docker Compose, usuario, contraseña, base y puerto son los de POSTGRES_* de abajo.
# Este valor se usa al correr Django y pytest en la laptop; el servicio web de
# Compose arma el suyo con el host db.
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
# Obligatoria: Docker Compose no arranca la base de datos sin ella.
# Va dentro de DATABASE_URL: usar solo letras, números, - y _ (sin @ : / ? #).
POSTGRES_PASSWORD=
# Puerto publicado en la laptop; si se omite, 5432. Cambiarlo si ya hay un PostgreSQL
# instalado, y usar el mismo puerto en DATABASE_URL.
POSTGRES_PORT=

# Archivos de sesiones de aprendizaje (Cloudflare R2 vía django-storages) – se usan en EN-03
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Vercel (EN-02). Vercel define VERCEL y las URL en cada despliegue: no se copian a mano
# a la laptop. Con VERCEL=1, settings.py activa HTTPS, cookies seguras y logs a stdout.
VERCEL=
# URL del despliegue, de su rama y de producción, sin https:// (entran a ALLOWED_HOSTS
# y a CSRF_TRUSTED_ORIGINS).
VERCEL_URL=
VERCEL_BRANCH_URL=
VERCEL_PROJECT_PRODUCTION_URL=
# Conexión directa de Neon (sin agrupar). La lee solo scripts/build_vercel.py (grupo 2)
# para aplicar las migraciones en el build; la aplicación usa DATABASE_URL (agrupada).
DATABASE_URL_UNPOOLED=
