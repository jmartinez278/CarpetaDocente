# Copiar este archivo como .env y completar los valores. No subir .env.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# Base de datos (PostgreSQL local con Docker Compose / Neon en la nube)
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Archivos de sesiones de aprendizaje (Cloudflare R2 vía django-storages)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
